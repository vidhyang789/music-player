<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".SettingsActivity">


<!--    <androidx.appcompat.widget.Toolbar-->
<!--        android:id="@+id/toolbarFB"-->
<!--        android:layout_width="match_parent"-->
<!--        android:background="@color/black"-->
<!--        android:layout_height="70dp"-->
<!--        app:title="Settings"-->
<!--        android:elevation="4dp"-->
<!--        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">-->

<!--    </androidx.appcompat.widget.Toolbar>-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="set_theme"
        android:background="@color/black"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="1.5dp"
        android:gravity="center"
        tools:ignore="HardcodedText">

    </TextView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/black">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/coolpinkSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/new_moon"
            android:tint="@color/cool_pink">

        </com.google.android.material.imageview.ShapeableImageView>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/coolblueSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/new_moon"
            android:tint="@color/cool_blue">

        </com.google.android.material.imageview.ShapeableImageView>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/purple500Settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/new_moon"
            android:tint="@color/purple_500">

        </com.google.android.material.imageview.ShapeableImageView>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/coolgreenSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/new_moon"
            android:tint="@color/cool_green">

        </com.google.android.material.imageview.ShapeableImageView>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/whiteSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/new_moon"
            android:tint="@color/white">

        </com.google.android.material.imageview.ShapeableImageView>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="@color/black"
        android:layout_marginVertical="2dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="set_theme"
            android:background="@color/black"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_weight="1"
            android:paddingStart="5dp"
            android:gravity="center|start"
            tools:ignore="HardcodedText,RtlSymmetry">

        </TextView>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/sortBtn"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@drawable/sort"
            android:padding="5dp">

        </com.google.android.material.imageview.ShapeableImageView>

    </LinearLayout>

    <TextView
        android:id="@+id/versionName"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="Version Name"
        android:background="@color/black"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:padding="16dp"
        tools:ignore="HardcodedText">

    </TextView>


</LinearLayout>