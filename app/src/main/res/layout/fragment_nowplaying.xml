<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/themeColor"
    tools:context=".nowplaying">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/songImgNP"
        android:layout_width="70dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="5dp"
        app:shapeAppearanceOverlay="@style/curve"
        android:src="@mipmap/music_player_icon_round">

    </com.google.android.material.imageview.ShapeableImageView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/nextbtnLP"
        android:layout_alignParentEnd="true"
        app:icon="@drawable/next_button"
        app:iconSize="40dp"
        app:iconTint="@color/white"
        android:layout_marginEnd="10dp"
        android:backgroundTint="?attr/themeColor"
        android:layout_centerVertical="true">

    </com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/playpauseNP"
        app:icon="@drawable/play"
        app:iconSize="40dp"
        app:iconTint="@color/white"
        android:layout_toStartOf="@id/nextbtnLP"
        android:backgroundTint="?attr/themeColor"
        android:layout_marginHorizontal="5dp"
        android:layout_centerVertical="true">

    </com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton>

    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:id="@+id/songNameNP"
        android:text="Song Name"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_toStartOf="@id/playpauseNP"
        android:layout_toEndOf="@id/songImgNP">

    </TextView>

</RelativeLayout>